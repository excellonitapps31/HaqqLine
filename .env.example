# Copy to .env for local runs of scripts/sync_elevenlabs.py and scripts/sync_twilio.py.
# .env is gitignored. Values live in GitHub Actions secrets for CI.

# ElevenLabs
ELEVENLABS_API_KEY=

# Optional. If empty, sync can create a webhook secret and print NEW_WEBHOOK_SECRET_CREATED=1.
# The host copy is public/api/data/elevenlabs_webhook.secret (not in git).
ELEVENLABS_WEBHOOK_SECRET=

# Twilio. Prefer the API key. Account SID + auth token is the fallback.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Purchased Voice number, E.164. Not a verified caller id. Not a DLD/RERA/RDC line.
TWILIO_VOICE_NUMBER=

# Local tests. Unset HAQQLINE_API_BASE and the phase 2 suite starts its own PHP server.
HAQQLINE_API_BASE=http://127.0.0.1:8787
# HAQQLINE_PLAY_BASE=https://haqqline.excellonit.net
# HAQQLINE_SKIP_AGENT_TESTS=1
# Phase 5 multi-run agent evals. Default is 3 when unset.
# HAQQLINE_TEST_REPEAT_COUNT=3
# HAQQLINE_TEST_WAIT_SECONDS=1500

# Deploy secrets are repository secrets only. They are not read by the Python scripts.
# SSH_PRIVATE_KEY, SSH_HOST, SSH_PORT, SSH_USER, DEPLOY_PATH
